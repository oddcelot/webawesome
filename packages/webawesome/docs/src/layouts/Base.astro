---
import DialogBaKickstarter from '../components/DialogBaKickstarter.astro';
import Head from '../components/Head.astro';
import NavProducts from '../components/NavProducts.astro';
import PageFooterContent from '../components/PageFooterContent.astro';
import Search from '../components/Search.astro';
import SlotAsideOutline from '../components/SlotAsideOutline.astro';
import SlotBannerBaKickstarter from '../components/SlotBannerBaKickstarter.astro';
import SlotNavigation from '../components/SlotNavigation.astro';
import SlotNavigationHeader from '../components/SlotNavigationHeader.astro';
import SlotSubheader from '../components/SlotSubheader.astro';
import { getAllPages } from '../lib/pages.js';
import { packageData } from '../lib/site.js';

/**
 * The shared page shell (formerly `_includes/base.njk`). Layouts pick the defaults for `hasSidebar` and
 * `hasOutline`; everything else comes from the page's front matter.
 */
interface Props {
  page: { url: string; fileSlug: string; data: Record<string, any> };
  /** The `layout-*` body class. */
  layout: string;
  hasSidebar?: boolean;
  hasOutline?: boolean;
  hasBreadcrumbs?: boolean;
}

const { page, layout } = Astro.props;
const { data } = page;
const hasSidebar = Astro.props.hasSidebar ?? data.hasSidebar ?? true;
const hasOutline = Astro.props.hasOutline ?? data.hasOutline ?? false;
const hasBreadcrumbs = Astro.props.hasBreadcrumbs ?? data.hasBreadcrumbs;
const hasAnchors = data.hasAnchors ?? true;
const hasBanner = data.hasBanner ?? true;
const hasSiteDialog = data.hasSiteDialog ?? true;
const hasGeneratedTitle = data.hasGeneratedTitle ?? true;
const hasLinkify = data.hasLinkify ?? true;
const pageType = data.pageClass || page.fileSlug || 'home';

const themeClasses =
  layout === 'site' || pageType === 'home'
    ? 'wa-brand-orange wa-palette-default wa-theme-site'
    : // The dev server fills these in from the theme cookies (see src/middleware.ts).
      'wa-brand- wa-palette- wa-theme-';

// Full-bleed pages (hasFramedMain: false) own their typography, so a stray hasProseContent inherited from the
// directory tree doesn't take effect.
const isProseWrapped = data.hasFramedMain !== false && data.hasProseContent;

const waPageAttributes = {
  view: 'desktop',
  'disable-navigation-toggle': true,
  'mobile-breakpoint': 960,
  'disable-sticky': 'banner',
  ...data.waPageAttributes,
};
const waPageAttrs = Object.fromEntries(
  Object.entries(waPageAttributes)
    .filter(([, value]) => value != null && value !== false)
    .map(([key, value]) => [key, String(value)]),
);

let breadcrumbParentUrl;
let breadcrumbParentTitle;
if (hasBreadcrumbs) {
  breadcrumbParentUrl = page.url.replace(`/${page.fileSlug}/`, '/');
  breadcrumbParentTitle = (await getAllPages()).find(item => item.url === breadcrumbParentUrl)?.data.title ?? breadcrumbParentUrl;
}

const outlineLabel = 'On This Page...';
const bodyClass = [
  `layout-${layout}`,
  `page-${pageType}`,
  isProseWrapped && 'has-prose-content',
  hasOutline && 'has-outline',
]
  .filter(Boolean)
  .join(' ');
---

<!doctype html>
<html
  lang="en"
  data-fa-kit-code="38c11e3f20"
  data-version={packageData.version}
  class={`wa-cloak ${themeClasses}`}
  data-no-anchor={hasAnchors === false ? '' : undefined}
  data-no-linkify={hasLinkify === false ? '' : undefined}
>
  <head>
    <Head page={page} />
    <meta name="theme-color" content="#f36944" />

    <script is:inline type="module" src="/assets/scripts/code-examples.js"></script>
    <script is:inline type="module" src="/assets/scripts/scroll.js"></script>
    {data.hasTurbo !== false && <script is:inline type="module" src="/assets/scripts/turbo.js" />}
    {data.hasSearch !== false && <script is:inline type="module" src="/assets/scripts/search.js" />}
    <script is:inline type="module" src="/assets/scripts/search-list.js"></script>
    <script is:inline type="module" src="/assets/scripts/outline.js"></script>
    {data.hasColorScheme !== false && <script is:inline type="module" src="/assets/scripts/color-scheme.js" />}
    <script is:inline type="module" src="/assets/scripts/theme.js"></script>
    <script is:inline type="module" src="/assets/scripts/install-tabs.js"></script>
    <script is:inline type="module" src="/assets/scripts/component-anatomy.js"></script>

    {Astro.slots.has('head') ? <slot name="head" /> : <link rel="stylesheet" href="/assets/styles/docs.css" />}

    <script is:inline type="module">
      // Set the initial color scheme before the page renders to prevent flashing
      const value = localStorage.getItem('color-scheme') || 'auto';
      const isDark = value === 'dark' || (value === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('wa-dark', isDark);

      // Detect platform for keyboard shortcut hints
      document.documentElement.classList.toggle('is-mac', /Mac|iPhone|iPad/.test(navigator.platform));

      function handleSSRChange(event) {
        const el = event.target;
        if (!el) {
          return;
        }

        if (el.id !== 'ssr-switch') {
          return;
        }

        el.checked ? setCookie({ name: 'webawesome_ssr', value: 'true' }) : removeCookie({ name: 'webawesome_ssr' });
        window.location.reload();
      }
      document.addEventListener('change', handleSSRChange);
    </script>
  </head>
  <body class={bodyClass}>
    <wa-page {...waPageAttrs}>
      {hasBanner && <SlotBannerBaKickstarter page={page} />}

      <header slot="header">
        <NavProducts page={page} />
      </header>

      <SlotSubheader page={page} />

      {hasSidebar && <SlotNavigationHeader page={page} />}
      {hasSidebar && <SlotNavigation page={page} />}

      {/* Even though the aside comes after "main" in the "flow", put it before because `<main>` is going to be large. */}
      {hasOutline && <SlotAsideOutline page={page} />}

      {/*
        Pages opt out of the default frame by setting `hasFramedMain: false` in their front matter — <main> then
        renders without .content-container, letting the page own its own layout.
      */}
      <main id="content" class={data.hasFramedMain !== false ? 'content-container' : undefined}>
        {
          hasOutline && (
            <nav id="outline-expandable" aria-label={outlineLabel}>
              <wa-details class="outline-links">
                <span class="wa-body-s wa-cluster wa-gap-xs" slot="summary">
                  <wa-icon name="book-open" variant="regular" /> {outlineLabel}
                </span>
              </wa-details>
            </nav>
          )
        }

        <Fragment set:html={isProseWrapped ? '<div class="wa-prose">' : ''} />
        <div id="flashes"></div>

        {
          hasBreadcrumbs && (
            <wa-breadcrumb class="page-breadcrumbs">
              <wa-icon slot="separator" name="angle-right" variant="regular" />
              <wa-breadcrumb-item href={breadcrumbParentUrl}>{breadcrumbParentTitle}</wa-breadcrumb-item>
              <wa-breadcrumb-item>{data.title}</wa-breadcrumb-item>
            </wa-breadcrumb>
          )
        }
        {hasGeneratedTitle && <h1 class="title">{data.title}</h1>}

        <slot name="before-content" />
        <slot />
        <slot name="after-content" />
        <Fragment set:html={isProseWrapped ? '</div>' : ''} />
      </main>

      <footer slot="main-footer" class="page-footer">
        <PageFooterContent page={page} />
      </footer>

      {data.hasSearch !== false && <Search page={page} />}

      {hasSiteDialog && <DialogBaKickstarter page={page} />}
    </wa-page>
  </body>
</html>
