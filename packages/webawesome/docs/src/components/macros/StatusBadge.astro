---
/** A single Stable or Experimental pill — safe to use inline in prose. */
interface Props {
  status?: string;
}

const { status } = Astro.props;
---

{
  status === 'stable' && (
    /* `.preview` opts the brand-variant badge out of site theming (orange). */
    <wa-badge class="preview" variant="brand" pill="">
      <wa-icon name="check" slot="start" />
      Stable
    </wa-badge>
  )
}
{
  status === 'experimental' && (
    <wa-badge variant="warning" appearance="filled" pill="">
      <wa-icon name="flask" slot="start" />
      Experimental
    </wa-badge>
  )
}
