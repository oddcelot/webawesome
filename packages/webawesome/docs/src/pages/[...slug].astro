---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getPages } from '../lib/pages.js';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages
    .filter(page => !page.url.endsWith('.html'))
    .map(page => ({ params: { slug: page.url.replace(/^\/|\/$/g, '') || undefined }, props: { page } }));
}

// Astro dev caches getStaticPaths() results, but the component manifest behind page.data.component changes while it
// runs, so look the page up again on every request
const page = import.meta.env.DEV ? (await getPages()).find(entry => entry.id === Astro.props.page.id) : Astro.props.page;
const { Content } = await render(page.entry);
---

<Layout page={page}><Content /></Layout>
