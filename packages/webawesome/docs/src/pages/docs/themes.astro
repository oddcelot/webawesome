---
import Layout from '../../layouts/Layout.astro';
import * as themer from '../../../_data/themer.js';
import ThemePicker from '../../components/theming/ThemePicker.astro';
import { getStaticPage } from '../../lib/pages.js';
import { renderMarkdown } from '../../lib/markdown.js';
import { cdnUrl, site } from '../../lib/site.js';

const page = getStaticPage('docs/themes');
const stripExtension = (s: string) => s.replace(/\.[^.]*$/, '');
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();

// Pro themes are only rendered for Pro users, which is never the case for the static build
const freeThemes = themer.themes.filter(theme => !theme.isPro);

const tag = (content: string) => `<wa-tag class="tag-ui" appearance="outlined">${content}</wa-tag>`;
const icon = (name: string) => `<wa-icon name="${name}" variant="regular"></wa-icon>`;

const themeInstructions = freeThemes.map(theme => {
  const name = stripExtension(theme.filename);
  const palette = stripExtension(theme.palette.filename);
  const classes = `<html
  class="wa-theme-${name} wa-palette-${palette} wa-brand-${theme.colorBrand.color}">`;
  return {
    name,
    cdn: `To use this theme, add the theme's stylesheet from the CDN:

\`\`\`html
<link rel="stylesheet" href="${cdnUrl('styles/themes/')}${theme.filename}">
\`\`\`

Then apply the following classes to the \`<html>\` element:

\`\`\`html
${classes}
\`\`\`
`,
    npm: `After installing <code>@awesome.me/webawesome</code>, import the theme's stylesheet:

\`\`\`js
import '@awesome.me/webawesome/dist/styles/themes/${theme.filename}';
\`\`\`

Then apply the following classes to the \`<html>\` element:

\`\`\`html
${classes}
\`\`\`
`,
    selfHosted: `If you're self-hosting Web Awesome, include the theme's stylesheet from your server:

\`\`\`html
<link rel="stylesheet" href="/dist/styles/themes/${theme.filename}">
\`\`\`

Then apply the following classes to the \`<html>\` element:

\`\`\`html
${classes}
\`\`\`
`,
    hosted: `**For projects on Free workspaces:**
1. Head over to your project's ${tag(`${icon('gear')} Settings`)}.
2. For your ${tag('Theme')}, select ${tag(`${icon('paintbrush')} ${capitalize(name)}`)}.
3. For your ${tag('Color Palette')}, select ${tag(`${icon('swatchbook')} ${capitalize(palette)}`)}.
4. Press ${tag('Save Changes')} to immediately update anywhere you're using your project.

**For projects on Pro workspaces:**
1. Head over to your project's ${tag(`${icon('gear')} Settings`)}.
2. Press ${tag(`${icon('paintbrush')} Edit Your Theme`)} to open the Theme Builder.
3. Open ${tag('Theme')} and select ${tag(capitalize(name))}.
4. Press ${tag('Save Theme')} to immediately update anywhere you're using your project.
`,
  };
});
---

<Layout page={page}>
  <h1>{page.data.title}</h1>

  <p>Themes give your project a cohesive look and feel across the entire Web Awesome library.</p>

  <p>
    A theme sets typography, spacing, borders, shadows, and how <a href="/docs/tokens/color#variant-colors">variants</a>
    show up on components — all as <a href="/docs/tokens">design tokens</a>. Two themes can share a <a
      href="/docs/color-palettes">color palette</a
    > and <a href="/docs/tokens/color#variant-colors">variant colors</a> and still feel completely different. Each pre-built
    theme ships with a default palette and may include custom overrides for individual components.
  </p>

  <ThemePicker />

  <wa-callout class="pro wa-brand-orange">
    <wa-icon slot="icon" name="crown" family="duotone" variant="regular" class="duotone-illustrated"></wa-icon>
    <div class="wa-stack">
      <div class="wa-stack wa-gap-2xs">
        <strong>
          <a href="/pro?from=pro-docs&context=themes">Unlock every theme with {site.namePro}!</a>
        </strong>

        <wa-details appearance="plain">
          <span slot="summary"
            >Subscribing to {site.namePro} unlocks every theme, plus premium color palettes, the visual Theme Builder, and
            <u class="appearance-underlined variant-drawn">more</u>.</span
          >

          <div class="wa-stack wa-gap-xl">
            <wa-button href="/pro?from=pro-docs&context=themes">
              Get {site.namePro}
              <wa-icon slot="end" name="arrow-right"></wa-icon>
            </wa-button>
          </div>
        </wa-details>
      </div>
    </div>
  </wa-callout>

  <h2>Using This Theme</h2>

  <div id="import-code">
    {
      themeInstructions.map((theme, index) => (
        <div class="theme-instructions" data-theme={theme.name} hidden={index !== 0}>
          <wa-tab-group data-install-tabs="">
            <wa-tab panel="cdn">
              <wa-icon name="globe" variant="regular" /> CDN
            </wa-tab>
            <wa-tab panel="npm">
              <wa-icon name="box-open" variant="regular" /> npm
            </wa-tab>
            <wa-tab panel="self-hosted">
              <wa-icon name="arrow-down-to-line" variant="regular" /> Self-Hosted
            </wa-tab>
            <wa-tab panel="hosted">
              <wa-icon name="rocket-launch" variant="regular" /> Hosted Projects
            </wa-tab>

            <wa-tab-panel name="cdn" set:html={renderMarkdown(theme.cdn)} />
            <wa-tab-panel name="npm" set:html={renderMarkdown(theme.npm)} />
            <wa-tab-panel name="self-hosted" set:html={renderMarkdown(theme.selfHosted)} />
            <wa-tab-panel name="hosted" set:html={renderMarkdown(theme.hosted)} />
          </wa-tab-group>
        </div>
      ))
    }
  </div>
</Layout>
